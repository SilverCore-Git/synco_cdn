# Copier en .env (docker/init.sh le fait et remplit les clés).

# --- Image --------------------------------------------------------------------
CDN_IMAGE_TAG=latest

# --- Stockage -------------------------------------------------------------------
# Répertoire de l'hôte partagé avec synco_api (son FM_DATA_DIR).
CDN_DATA_DIR=/srv/synco/storage
# Propriétaire de CDN_DATA_DIR (ls -n) : le CDN tourne sous cette identité.
CDN_UID=10001
CDN_GID=10001
# Options de montage du stockage : rw, ou z sur un hôte SELinux
# (étiquette le répertoire pour les conteneurs ; réglé par docker/init.sh).
CDN_DATA_MOUNT_OPTIONS=rw
CDN_MIN_FREE_BYTES=20GiB
CDN_MIN_FREE_PERCENT=5

# --- Réseau ---------------------------------------------------------------------
# Adresses de l'hôte où publier les ports (nginx → public, synco_api → interne).
CDN_PUBLIC_BIND=127.0.0.1:9100
CDN_INTERNAL_BIND=127.0.0.1:9101
# Écouteur des rappels de synco_api (CDN_CALLBACK_LISTEN côté API), vu
# depuis le conteneur. host.docker.internal = passerelle docker0 (172.17.0.1).
CDN_API_INTERNAL_URL=http://host.docker.internal:9002
# Origines autorisées (tableau TOML) : web, Tauri, Capacitor.
CDN_CORS_ALLOWED_ORIGINS=["https://app.synco.one","tauri://localhost","http://tauri.localhost","capacitor://localhost"]

# --- Tickets ----------------------------------------------------------------------
# Table TOML kid → clé publique Ed25519 (base64). Rempli par docker/init.sh.
# Rotation : ajouter la nouvelle clé à côté de l'ancienne, puis
# `docker compose up -d` (recrée le conteneur).
CDN_TICKET_PUBLIC_KEYS=

# --- Secrets ----------------------------------------------------------------------
# Secret HMAC partagé avec synco_api (hexadécimal), créé par docker/init.sh.
CDN_INTERNAL_SECRET_FILE=./secrets/cdn_internal_secret

# --- Limites et exploitation ------------------------------------------------------
CDN_MAX_FILE_BYTES=10GiB
CDN_BUFFER_BUDGET_BYTES=512MiB
CDN_MEMORY_LIMIT=2g
# direct, ou accel (envoi délégué à nginx, cf. deploy/nginx.conf)
CDN_DOWNLOAD_MODE=direct
CDN_LOG_LEVEL=info
